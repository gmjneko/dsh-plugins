{
  "name": "@local/dsh-animation-enhance",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "KoWork-style motion for DeepSeek Harness: step disclosures, menus, settings, and panel switches.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
